{
  "name": "parabank-qa",
  "version": "1.0.0",
  "private": true,
  "description": "UI, REST and SOAP test automation for the ParaBank demo application",
  "scripts": {
    "parabank:up": "docker compose up -d",
    "parabank:down": "docker compose down",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:soap": "playwright test --project=soap",
    "test:ui": "playwright test --project=ui",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
